# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/operational_memory
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:postgres@localhost:5432/operational_memory

# Application
APP_NAME=Operational Memory
APP_ENV=development
DEBUG=true

# CORS
FRONTEND_URL=http://localhost:3000

# Server
HOST=0.0.0.0
PORT=8000

# AI / LLM (get free key from https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash

# File uploads
UPLOAD_DIR=uploads
